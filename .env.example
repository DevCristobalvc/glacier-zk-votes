# Environment variables for Glacier

# ========================================
# Deployer Configuration
# ========================================

# Private key for deploy (WITHOUT 0x prefix for some tools)
PRIVATE_KEY=your_private_key_here

# ========================================
# Avalanche RPC URLs
# ========================================

# Fuji Testnet (development and testing)
AVALANCHE_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Mainnet (production)
AVALANCHE_MAINNET_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Local RPC for development
LOCAL_RPC_URL=http://localhost:8545

# ========================================
# External Services API Keys
# ========================================

# Snowtrace API key for contract verification
# Get at: https://snowtrace.io/apis
SNOWTRACE_API_KEY=your_snowtrace_api_key

# ========================================
# Development Configuration
# ========================================

# Current environment (development, staging, production)
NODE_ENV=development

# Frontend environment
VITE_ENVIRONMENT=development

# Debug mode for additional logs
DEBUG=true

# ========================================
# ZK Configuration
# ========================================

# Directory for ptau files (powers of tau)
PTAU_DIR=./zk-circuits/ptau

# Use server for proof generation (true/false)
# In production should be false (client-side)
ZK_USE_SERVER=false

# ========================================
# Frontend Configuration
# ========================================

# Base API URL (if exists)
VITE_API_BASE_URL=http://localhost:3001

# Wallet mode (metamask, avalanche, all)
VITE_WALLET_MODE=all

# Enable analytics (true/false)
VITE_ENABLE_ANALYTICS=false

# ========================================
# Testing Configuration
# ========================================

# Seed for reproducible tests
TEST_SEED=12345

# Number of voters for tests
TEST_VOTER_COUNT=100

# ========================================
# Deploy Configuration
# ========================================

# Verify contracts automatically
AUTO_VERIFY=true

# Number of confirmations to consider deploy successful
CONFIRMATIONS=3

# Gas price in gwei (only if automatic estimation is not used)
GAS_PRICE_GWEI=25

# ========================================
# Service URLs (Optional)
# ========================================

# IPFS gateway for metadata
IPFS_GATEWAY=https://gateway.pinata.cloud

# Notification service
NOTIFICATION_SERVICE_URL=

# ========================================
# Security Configuration
# ========================================

# Enable rate limiting
ENABLE_RATE_LIMIT=true

# Maximum requests per minute
MAX_REQUESTS_PER_MINUTE=60

# ========================================
# Monitoring Configuration
# ========================================

# Sentry DSN for error tracking
SENTRY_DSN=

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# ========================================
# Configuration Notes
# ========================================

# 1. Never commit .env with real values
# 2. Use .env.local for local overrides
# 3. Verify all variables are defined before deploy
# 4. For production, use secrets management services